# What is NOT tracked. Everything here stays on disk; git just ignores it.

# System and Python junk
.DS_Store
__pycache__/
*.pyc
.venv/
.env

# Secrets, in case any ever appear
*.key
model-key
*secret*

# Databases and state snapshots (regenerated by the generators, or raw run state)
*.sqlite
*.sqlite-journal

# archive/merrow-alderbridge/mac_container (Euryla/Merrow): 3.1 GB, ~370k files of run output and office copies.
# Its scripts and JSON configs at the top level are tracked; the subfolders are not.
archive/merrow-alderbridge/mac_container/*/

# Frozen office drives of the stopped Merrow thread: identical snapshots (~600 files each).
# Anchored to the archive: elsewhere `office/` is generator code and must stay tracked.
archive/merrow-alderbridge/office/
archive/merrow-alderbridge/office_v2/
archive/merrow-alderbridge/office_v3/
archive/merrow-alderbridge/office_r1*/
archive/merrow-alderbridge/office_r2*/
archive/merrow-alderbridge/scenario_b_v*/
archive/merrow-alderbridge/workspace/
archive/merrow-alderbridge/research/merrow-v7-four-framings/*/office/

# George's auth-bench-4: a snapshot of his own GitHub repo, worked on separately by Codex
auth-bench-4/

# Raw agent traces and copied drives inside run folders (reports and result.json stay tracked)
**/drive-after/
**/pi.jsonl
**/session.jsonl
**/pi.stderr.txt
**/relay/
**/agent-files/

# Old scratch
tmp/

# Office copies and images inside office_review (Merrow, stopped)
archive/merrow-alderbridge/office_review/merrow_fit_only_v1/
archive/merrow-alderbridge/office_review/v8_portrait_sources/

# Published Merrow v7 environment: its own git repository
archive/merrow-alderbridge/output/repository/judgment-action-gap-environment/

# Power company (clock-fixed auth-bench-4): run folders hold raw traces; only batch plans and
# per-run result.json are tracked, summaries go in research/power-company/*.md.
research/power-company/**/runs/**
!research/power-company/**/runs/**/
!research/power-company/**/runs/**/result.json
!research/power-company/**/runs/**/label.json
!research/power-company/**/runs/*/batch.json
research/power-company/**/launch.log

# Leftovers from the computer cleanup (19.10): Desktop copy of the Merrow office, papers from Downloads
archive/merrow-alderbridge/desktop_copy/
research/papers/

# Aborted parcel pilots (v16, v17): never part of the results
parcel-office/action-pilot-v16/aborted/
parcel-office/action-pilot-v16/launch.log
parcel-office/action-pilot-v17/aborted/

# Power company living cards (15.10): raw traces stay local and in restic; results and reports are tracked
research/auth-bench-4-living-cards/runs/**
!research/auth-bench-4-living-cards/runs/**/
!research/auth-bench-4-living-cards/runs/**/result.json
!research/auth-bench-4-living-cards/runs/**/label.json

# Dataset export for sharing (large; the zip is built from it)
research/dataset/export/
research/dataset/build/
